// HRMS Aisahub data model — see docs/plans/2026-07-08-hrms-design.md §3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum LeaveType {
  PAID
  SICK
  UNPAID
}

// Overtime and Reimbursement only — leave has no approval step.
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HolidayType {
  NATIONAL
  COMPANY
  JOINT_LEAVE
  SPECIAL
}

enum PayrollStatus {
  DRAFT
  FINALIZED
}

// Why an employment ended. Nullable on the row: rows created by the backfill migration have
// no recorded reason, while the terminate endpoint requires one.
enum EmploymentEndReason {
  CONTRACT_END
  RESIGNATION
  DISMISSAL
  OTHER
}

enum NotificationType {
  LEAVE_SUBMITTED
  LEAVE_DECIDED // retained for historical rows only — leave no longer has an approval step
  OVERTIME_SUBMITTED
  OVERTIME_DECIDED
  REIMBURSEMENT_SUBMITTED
  REIMBURSEMENT_DECIDED
  PAYSLIP_AVAILABLE
  REQUEST_CANCELLED
  CONTRACT_ENDING
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // HR | EMPLOYEE
  users User[]
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  employeeId   Int?      @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reviewedOvertime        Overtime[]      @relation("OvertimeReviewer")
  reviewedReimbursements  Reimbursement[] @relation("ReimbursementReviewer")
  finalizedPayrollPeriods PayrollPeriod[] @relation("PayrollFinalizer")
  // Fifth SET NULL foreign key pointing at User — see the deletion note in CLAUDE.md.
  recordedEmployments     Employment[]    @relation("EmploymentRecorder")
  notifications           Notification[]  @relation("NotificationRecipient")
  resolvedNotifications   Notification[]  @relation("NotificationResolver")
}

model Employee {
  id                Int            @id @default(autoincrement())
  fullName          String
  nickname          String?
  joinDate          DateTime
  position          String
  employmentType    EmploymentType
  monthlySalary     Decimal?       @db.Decimal(15, 2)
  hourlyRate        Decimal?       @db.Decimal(15, 2)
  email             String?
  university        String?
  major             String?
  graduationYear    Int?
  linkedinUrl       String?
  religion          String?
  thrEligible       Boolean        @default(false)
  bankName          String?
  bankAccountNumber String?
  ktpNumber         String?
  phoneNumber       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // joinDate above is the ORIGINAL first join, kept for tenure across a rehire. The dates
  // that describe the current engagement live on Employment; there is no isActive column,
  // because "currently employed" means "has an Employment row with endDate NULL".
  employments    Employment[]
  user           User?
  leaveAccruals  LeaveAccrual[]
  leaveRequests  LeaveRequest[]
  dailyLogs      DailyLog[]
  overtimes      Overtime[]
  reimbursements Reimbursement[]
  payslips       Payslip[]
}

// One row per continuous stretch of employment. A rehire opens a new row rather than
// editing the old one, which is what makes the history auditable and keeps a returning
// employee's leave from inheriting the previous engagement's accrual.
//
// Named Employment, not EmploymentPeriod: PayrollPeriod, LeaveAccrual.period and
// assertPeriodEditable already own "period" here, and a second meaning would confuse.
model Employment {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id])
  startDate  DateTime // join or rehire date, UTC midnight
  // NULL means currently employed. A date in the future is a served notice period: the
  // employee stays active until it arrives, with nothing scheduled to flip them.
  endDate    DateTime?

  endReason EmploymentEndReason? // NULL only on rows created by the backfill migration
  endNote   String?

  // The contract window for THIS engagement. A rehire gets its own, so renewing or
  // re-signing never overwrites the previous contract's dates or file.
  contractStartDate DateTime?
  contractEndDate   DateTime?
  contractFilePath  String?

  // Accrual anchor for THIS engagement: paid leave is earned from the date the employee
  // became full-time, not from startDate. NULL for part-timers, who neither take nor earn
  // leave. Scoping it here is what stops a rehire backfilling the months away.
  fullTimeSince DateTime?

  // Balance frozen at termination. Recorded rather than paid out — see the design doc.
  leaveBalanceAtEnd Decimal? @db.Decimal(6, 2)

  recordedById Int?
  recordedBy   User?    @relation("EmploymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leaveAccruals LeaveAccrual[]

  // Backs the composite foreign key from LeaveAccrual — see the migration for why.
  @@unique([id, employeeId])
  @@index([employeeId])
  @@index([contractEndDate])
}

model LeaveAccrual {
  id           Int        @id @default(autoincrement())
  employeeId   Int
  employee     Employee   @relation(fields: [employeeId], references: [id])
  employmentId Int
  // Composite: the accrual's employment must belong to the accrual's employee.
  employment   Employment @relation(fields: [employmentId, employeeId], references: [id, employeeId])
  period       DateTime // first day of the accrual month
  days         Decimal    @default(1) @db.Decimal(6, 2)
  daysConsumed Decimal    @default(0) @db.Decimal(6, 2)
  expiresAt    DateTime // period + 18 months
  createdAt    DateTime   @default(now())

  // Scoped to the employment, not the employee: someone terminated and rehired inside one
  // month would otherwise collide on (employeeId, period) and the second row would be lost.
  @@unique([employmentId, period])
  @@index([employeeId])
}

// Leave has no approval step: a stored row is leave that is taken, effective on submit.
model LeaveRequest {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id])
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  totalDays  Decimal   @db.Decimal(6, 2) // working days excl. weekends & holidays
  reason     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Holiday {
  id        Int         @id @default(autoincrement())
  name      String
  date      DateTime    @unique @db.Date
  type      HolidayType @default(NATIONAL)
  notes     String?
  createdAt DateTime    @default(now())
}

model DailyLog {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime @db.Date
  hours      Decimal  @db.Decimal(6, 2)
  project    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date]) // one log per employee per date (design §4)
}

model Overtime {
  id           Int           @id @default(autoincrement())
  employeeId   Int
  employee     Employee      @relation(fields: [employeeId], references: [id])
  date         DateTime      @db.Date
  hours        Decimal       @db.Decimal(6, 2)
  description  String?
  status       RequestStatus @default(PENDING)
  reviewedById Int?
  reviewedBy   User?         @relation("OvertimeReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Reimbursement {
  id               Int           @id @default(autoincrement())
  employeeId       Int
  employee         Employee      @relation(fields: [employeeId], references: [id])
  date             DateTime      @db.Date
  amount           Decimal       @db.Decimal(15, 2) // IDR
  description      String
  evidenceFilePath String
  status           RequestStatus @default(PENDING)
  reviewedById     Int?
  reviewedBy       User?         @relation("ReimbursementReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  rejectReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model PayrollPeriod {
  id            Int           @id @default(autoincrement())
  year          Int
  month         Int
  startDate     DateTime      @db.Date
  endDate       DateTime      @db.Date
  exchangeRate  Decimal       @db.Decimal(15, 4) // IDR per USD
  rateSource    String        @default("API") // API | FALLBACK | MANUAL (design §4 / Phase 5)
  status        PayrollStatus @default(DRAFT)
  finalizedAt   DateTime?
  finalizedById Int?
  finalizedBy   User?         @relation("PayrollFinalizer", fields: [finalizedById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payslips Payslip[]

  @@unique([year, month])
}

model Payslip {
  id                 Int           @id @default(autoincrement())
  payrollPeriodId    Int
  payrollPeriod      PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  employeeId         Int
  employee           Employee      @relation(fields: [employeeId], references: [id])
  basicSalary        Decimal       @db.Decimal(15, 2)
  overtimePay        Decimal       @default(0) @db.Decimal(15, 2)
  reimbursementTotal Decimal       @default(0) @db.Decimal(15, 2)
  leaveDeduction     Decimal       @default(0) @db.Decimal(15, 2)
  totalIdr           Decimal       @db.Decimal(15, 2)
  totalUsd           Decimal       @db.Decimal(15, 2)
  detail             Json? // full computation breakdown snapshot
  createdAt          DateTime      @default(now())

  @@unique([payrollPeriodId, employeeId])
}

// In-app notification. entityId is deliberately NOT a foreign key: cancelling a
// request hard-deletes the row, and the "this was cancelled" notification has to
// outlive the record it describes.
model Notification {
  id           Int              @id @default(autoincrement())
  recipientId  Int
  recipient    User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type         NotificationType
  entityType   String
  entityId     Int
  payload      Json
  groupKey     String? // "<ENTITY>:<id>" — ties an HR fan-out together so acting on one resolves all
  readAt       DateTime?
  resolvedAt   DateTime?
  resolvedById Int?
  resolvedBy   User?            @relation("NotificationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([groupKey])
}
