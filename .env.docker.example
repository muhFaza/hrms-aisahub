# Template for the VPS .env — copy to ~/hrms/.env on the server and fill in.
# docker-compose.prod.yml reads this file. Never commit the filled-in version.
#
#   scp .env.docker.example fazadev@202.74.75.193:~/hrms/.env
#   ssh fazadev@202.74.75.193 'chmod 600 ~/hrms/.env && vi ~/hrms/.env'

# --- Database -------------------------------------------------------------
# Only ever reached over the internal Docker network, but still use a real
# password: it is also the credential for manual psql sessions.
POSTGRES_USER=hrms
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand
POSTGRES_DB=hrms

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=12h

# --- Demo data ------------------------------------------------------------
# true  -> seed demo data, but ONLY when the database is empty
# false -> never seed
#
# The entrypoint's empty check matters: seed.ts wipes all 11 tables before
# inserting, so seeding a populated database destroys its contents.
SEED_ON_START=true
