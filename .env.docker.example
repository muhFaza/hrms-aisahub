# Template for the VPS .env. There are TWO deployments on that box, each with its
# own directory and its own .env — never a shared one. Copy this file to both and
# fill each in separately.
#
#   Demo (thesis)   ~/hrms/.env        docker-compose.demo.yml  hrms.muhammadfaza.com
#   Live (Aisahub)  ~/hrms-live/.env   docker-compose.live.yml  hr.muhammadfaza.com
#
#   scp .env.docker.example fazadev@202.74.75.193:~/hrms-live/.env
#   ssh fazadev@202.74.75.193 'chmod 600 ~/hrms-live/.env && vi ~/hrms-live/.env'
#
# Never commit the filled-in version. CI syncs the compose files but refuses to
# overwrite .env.

# --- Database -------------------------------------------------------------
# Each instance has its own Postgres container, so these are per-instance
# credentials for a database only that instance can reach. Still use real
# passwords: they are also the credential for manual psql sessions.
POSTGRES_USER=hrms
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand
POSTGRES_DB=hrms

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
#
# ⚠️ THE TWO INSTANCES MUST HAVE DIFFERENT SECRETS. Generate each one separately;
# do not copy ~/hrms/.env to ~/hrms-live/.env and edit it.
#
# middleware/auth.ts takes only the userId from a token and re-reads the role from
# the database. With a shared secret, a token minted by the demo's hr@aisahub.com —
# whose password is printed on the demo login page for anyone to read — is a
# structurally valid token for the same user ID on the live instance, which is the
# real HR account. That is a full authentication bypass into real salary data.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=12h

# --- Demo data (demo instance only) ---------------------------------------
# true  -> seed demo data, but ONLY when the database is empty
# false -> never seed
#
# The entrypoint's empty check matters: seed.ts wipes all 11 tables before
# inserting, so seeding a populated database destroys its contents.
#
# Only docker-compose.demo.yml reads this. The live compose file hard-codes
# SEED_ON_START=false so no variable on the box can turn seeding on there.
SEED_ON_START=true

# DEMO_MODE (the click-to-login account list on the login page) is NOT set here.
# It is fixed in each compose file — true in demo, false in live — so it cannot be
# flipped on for the live instance by editing a .env.

# --- First HR account (live instance only) --------------------------------
# BOOTSTRAP_ON_START is set to true in docker-compose.live.yml. On an empty
# database the entrypoint creates the HR and EMPLOYEE roles and this one HR
# account (bcrypt cost 10, no employee profile). Nothing else creates them on the
# live instance, so without these nobody can log in.
#
# It never deletes and never touches existing users: once any user exists it logs
# and skips. Both variables are required when BOOTSTRAP_ON_START=true.
#
# Remove BOOTSTRAP_HR_PASSWORD from this file once HR has changed the password
# through the in-app flow, then `docker compose up -d` to pick up the removal.
BOOTSTRAP_HR_EMAIL=hr@aisahub.com
BOOTSTRAP_HR_PASSWORD=CHANGE_ME_then_delete_this_line_after_first_login
